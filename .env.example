# Copy this file to .env and fill in values. Never commit real keys.
# OpenAI is optional: the bot falls back to grounded KB templates if omitted.
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace token is optional. Public MiniLM embeddings work without it.
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
